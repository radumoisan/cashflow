{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "explore": {
      "model": "openai/gpt-5.6-luna",
      "reasoningEffort": "low"
    },
    "general": {
      //"model": "opencode-go/deepseek-v4-flash",
      "model": "openai/gpt-5.6-terra",
      "variant": "high"
    },
    "plan": {
      "model": "openai/gpt-5.6-sol",
      "reasoningEffort": "xhigh"
    }
  },
  "permission": {
    "bash": "allow",
    "external_directory": "allow"
  }
}
